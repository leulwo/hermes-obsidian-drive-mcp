{
  "name": "hermes-obsidian-drive-mcp",
  "version": "0.1.0",
  "description": "Hermes-first MCP bridge for Obsidian vaults synced by Richard Xiong's Google Drive Sync plugin",
  "author": "VaporGrid",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "auth": "tsx src/auth.ts",
    "setup": "tsx src/setup.ts",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx src/integration-test.ts",
    "doctor": "tsx src/doctor.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "google-auth-library": "^11.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.0"
  }
}
