# Optional overrides. After npm run setup these are not required at startup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OBSIDIAN_VAULT_NAME=
OBSIDIAN_TIMEZONE=UTC
OBSIDIAN_ALLOW_DELETE=true
OBSIDIAN_MCP_AUTO_UPDATE=false

# Optional paths. Defaults use the user's platform config directory.
OBSIDIAN_MCP_CONFIG_DIR=
OBSIDIAN_MCP_CONFIG_FILE=
OBSIDIAN_MCP_TOKEN_FILE=
